📄 4. src/my_cli/[main.py](main.py)
"""
Typer CLI Entrypoint — Host machine commands
Agents import from services.py, NOT this file
"""
import typer
from rich.console import Console
from rich.table import Table
from my_cli.services import DataProcessor, FileManager, SystemService

app = typer.Typer(
    name="mycli",
    help="Project CLI — AI Agent services available in my_cli.services",
    add_completion=True,
)
console = Console()


@app.command()
def info():
    """Show project & system info"""
    info = SystemService.get_info()
    table = Table("Key", "Value")
    for k, v in info.items():
        table.add_row(k, str(v))
    console.print(table)


@app.command()
def summarize(text: str, max_len: int = 100):
    """Summarize input text"""
    result = DataProcessor.summarize_text(text, max_len)
    console.print(f"📝 Summary: {result['summary']}")
    console.print(f"📊 Original length: {result['original_length']} chars")


@app.command()
def read_json(path: str):
    """Read and display JSON file"""
    data = FileManager.read_json(path)
    if data is None:
        console.print("[red]❌ File not found[/red]")
        raise typer.Exit(1)
    console.print_json(data=data)


@app.command()
def write_json(path: str, key: str, value: str):
    """Write a key-value pair to JSON file"""
    data = FileManager.read_json(path) or {}
    data[key] = value
    if FileManager.write_json(path, data):
        console.print("[green]✅ File saved[/green]")
    else:
        console.print("[red]❌ Failed to save[/red]")


@app.command()
def list_files(directory: str = ".", pattern: str = "*"):
    """List files in directory"""
    files = FileManager.list_files(directory, pattern)
    console.print(f"📂 Found {len(files)} file(s):")
    for f in files:
        console.print(f"  • {f}")


if __name__ == "__main__":
    app()

