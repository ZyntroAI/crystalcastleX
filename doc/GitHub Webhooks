require('dotenv').config();
const express = require('express');
const crypto = require('crypto');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 5000;

// ─── Config ───
const WEBHOOK_SECRET = process.env.GITHUB_WEBHOOK_SECRET;
const ADMIN_KEY = process.env.ADMIN_KEY;
if (!WEBHOOK_SECRET) throw new Error('GITHUB_WEBHOOK_SECRET not set');

const PYTHON_WORKER_URL = process.env.PYTHON_WORKER_URL;
const NEXTJS_URL = process.env.NEXTJS_URL;
const FORWARD_PYTHON = process.env.FORWARD_PYTHON !== 'false';
const FORWARD_NEXTJS = process.env.FORWARD_NEXTJS !== 'false';
const LOG_DIR = process.env.LOG_DIR || './logs';
const PAYLOAD_DIR = process.env.PAYLOAD_DIR || './payloads';
const MAX_RETRIES = parseInt(process.env.MAX_RETRIES || '5', 10);
const RETRY_DELAY_BASE = parseInt(process.env.RETRY_DELAY_BASE || '1000', 10);

// ─── Ensure Directories ───
[LOG_DIR, PAYLOAD_DIR].forEach(dir => fs.mkdirSync(dir, { recursive: true }));

const logPath = path.join(LOG_DIR, 'deliveries.log');
const failedPath = path.join(LOG_DIR, 'failed-forwarding.log');
const replayLogPath = path.join(LOG_DIR, 'replays.log');

// ─── Persistence Helpers ───
function getPayloadPath(deliveryId) {
  // Group by date folder for easier management
  const date = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
  const dateDir = path.join(PAYLOAD_DIR, date);
  fs.mkdirSync(dateDir, { recursive: true });
  return path.join(dateDir, `${deliveryId}.json`);
}

function savePayload(deliveryId, payload, headers) {
  const filePath = getPayloadPath(deliveryId);
  const data = {
    deliveryId,
    timestamp: new Date().toISOString(),
    event: headers['x-github-event'],
    signature: headers['x-hub-signature-256'],
    headers: Object.fromEntries(Object.entries(headers).filter(([k]) => k.startsWith('x-github') || k.startsWith('x-hub') || k === 'user-agent')),
    payload
  };
  fs.writeFileSync(filePath, JSON.stringify(data, null, 2));
  return filePath;
}

function loadPayload(deliveryId) {
  // Search by date folders or do a broad search
  // Simplified: scan all date folders
  const dirs = fs.readdirSync(PAYLOAD_DIR).filter(f => fs.statSync(path.join(PAYLOAD_DIR, f)).isDirectory());
  for (const dateDir of dirs) {
    const candidate = path.join(PAYLOAD_DIR, dateDir, `${deliveryId}.json`);
    if (fs.existsSync(candidate)) {
      return JSON.parse(fs.readFileSync(candidate, 'utf8'));
    }
  }
  return null;
}

// ─── Logging ───
function appendLog(file, entry) {
  const line = JSON.stringify({ ts: new Date().toISOString(), ...entry }) + '\n';
  fs.appendFile(file, line, err => {
    if (err) console.error('Write log failed:', err.message);
  });
}

function delay(ms) {
  return new Promise(res => setTimeout(res, ms));
}

// ─── Forward with Retry ───
async function forwardWithRetry(url, payload, headers, serviceName) {
  let lastError;
  for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
    try {
      const res = await fetch(url, {
        method: 'POST',
        timeout: 10000,
        headers: {
          'Content-Type': 'application/json',
          'X-GitHub-Event': headers['x-github-event'] || '',
          'X-GitHub-Delivery': headers['x-github-delivery'] || '',
          'X-Forwarded-From': 'express-primary',
          'X-Retry-Attempt': String(attempt),
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        appendLog(logPath, {
          deliveryId: headers['x-github-delivery'],
          service: serviceName,
          status: 'forwarded',
          attempt,
          statusCode: res.status
        });
        return { ok: true, attempt };
      }
      throw new Error(`HTTP ${res.status}`);
    } catch (err) {
      lastError = err;
      console.warn(`[${serviceName}] Attempt ${attempt}/${MAX_RETRIES}: ${err.message}`);
      if (attempt < MAX_RETRIES) {
        const waitMs = RETRY_DELAY_BASE * (2 ** (attempt - 1));
        await delay(waitMs);
      }
    }
  }

  appendLog(failedPath, {
    deliveryId: headers['x-github-delivery'],
    service: serviceName,
    status: 'failed',
    attempts: MAX_RETRIES,
    error: lastError?.message
  });
  return { ok: false, error: lastError?.message };
}

// ─── Middleware ───
app.use(cors({ origin: process.env.ALLOWED_ORIGINS?.split(',') }));
app.use(express.json({ limit: '5mb', verify: (req, _, buf) => { req.rawBody = buf; } }));

// ─── Signature Verification ───
function verifySignature(rawBody, signatureHeader) {
  if (!signatureHeader) return false;
  const hmac = crypto.createHmac('sha256', WEBHOOK_SECRET);
  const digest = `sha256=${hmac.update(rawBody).digest('hex')}`;
  return crypto.timingSafeEqual(Buffer.from(digest), Buffer.from(signatureHeader));
}

// ─── Remove from Failed Log ───
function removeFromFailedLog(deliveryId, service) {
  if (!fs.existsSync(failedPath)) return;
  const lines = fs.readFileSync(failedPath, 'utf8')
    .split('\n')
    .filter(line => line.trim())
    .filter(line => {
      try {
        const entry = JSON.parse(line);
        return !(entry.deliveryId === deliveryId && entry.service === service);
      } catch { return true; }
    });
  fs.writeFileSync(failedPath, lines.join('\n') + '\n');
}

// ─── PRIMARY WEBHOOK ENDPOINT ───
app.post('/api/github-webhook', async (req, res) => {
  const sig = req.headers['x-hub-signature-256'];
  const event = req.headers['x-github-event'];
  const deliveryId = req.headers['x-github-delivery'] || 'unknown';

  appendLog(logPath, { deliveryId, event, status: 'received' });

  // Security
  if (!verifySignature(req.rawBody, sig)) {
    appendLog(logPath, { deliveryId, status: 'rejected', reason: 'invalid_signature' });
    return res.status(403).json({ error: 'Invalid signature' });
  }

  // Save FULL payload immediately
  const payload = req.body;
  savePayload(deliveryId, payload, req.headers);

  // Ping
  if (event === 'ping') {
    appendLog(logPath, { deliveryId, status: 'pong' });
    return res.status(200).json({ status: 'ok', message: 'pong', deliveryId });
  }

  // ACK immediately
  res.status(202).json({
    status: 'accepted',
    deliveryId,
    event,
    stored: true,
    forwarded: { python: FORWARD_PYTHON, nextjs: FORWARD_NEXTJS }
  });

  // Background forward
  setImmediate(async () => {
    if (FORWARD_PYTHON) await forwardWithRetry(PYTHON_WORKER_URL, payload, req.headers, 'python');
    if (FORWARD_NEXTJS) await forwardWithRetry(NEXTJS_URL, payload, req.headers, 'nextjs');
  });
});

// ─── REPLAY ENDPOINT — Full Payload Recovery ───
app.post('/api/replay-failed', async (req, res) => {
  // Admin auth
  const adminKey = req.headers['x-admin-key'];
  if (ADMIN_KEY && adminKey !== ADMIN_KEY) {
    return res.status(401).json({ error: 'Unauthorized — invalid X-Admin-Key' });
  }

  const { deliveryId, service } = req.body || {};

  // List all failed
  if (!deliveryId) {
    const failed = fs.existsSync(failedPath)
      ? fs.readFileSync(failedPath, 'utf8')
          .split('\n').filter(Boolean)
          .map(line => { try { return JSON.parse(line); } catch { return null; } })
          .filter(Boolean)
      : [];
    return res.json({
      count: failed.length,
      failed,
      payloadDir: PAYLOAD_DIR
    });
  }

  // Load ORIGINAL full payload from storage
  const stored = loadPayload(deliveryId);
  if (!stored) {
    return res.status(404).json({
      error: 'Delivery not found',
      message: `No stored payload for deliveryId: ${deliveryId}`
    });
  }

  // Validate service
  const url = service === 'python' ? PYTHON_WORKER_URL :
              service === 'nextjs' ? NEXTJS_URL : null;
  if (!url) {
    return res.status(400).json({ error: 'Invalid service — use "python" or "nextjs"' });
  }

  // Replay with ORIGINAL payload
  console.log(`🔄 Replaying ${deliveryId} → ${service}`);
  const replayHeaders = {
    'x-github-delivery': deliveryId,
    'x-github-event': stored.event
  };
  const result = await forwardWithRetry(url, stored.payload, replayHeaders, service);

  if (result.ok) {
    removeFromFailedLog(deliveryId, service);
    appendLog(replayLogPath, {
      deliveryId,
      service,
      status: 'replayed_success',
      attempt: result.attempt,
      originalEvent: stored.event
    });
    return res.json({
      status: 'replayed_success',
      deliveryId,
      service,
      event: stored.event,
      attempt: result.attempt
    });
  }

  appendLog(replayLogPath, {
    deliveryId,
    service,
    status: 'replay_failed',
    error: result.error
  });
  return res.status(502).json({
    status: 'replay_failed',
    deliveryId,
    service,
    error: result.error
  });
});

// ─── Retrieve Single Payload ───
app.get('/api/payload/:deliveryId', async (req, res) => {
  const adminKey = req.headers['x-admin-key'];
  if (ADMIN_KEY && adminKey !== ADMIN_KEY) {
    return res.status(401).json({ error: 'Unauthorized' });
  }
  const stored = loadPayload(req.params.deliveryId);
  if (!stored) {
    return res.status(404).json({ error: 'Not found' });
  }
  return res.json(stored);
});

// ─── Health ───
app.get('/health', (_, res) => res.json({
  status: 'healthy',
  timestamp: new Date().toISOString(),
  payloadDir: PAYLOAD_DIR,
  logDir: LOG_DIR
}));

app.listen(PORT, () => {
  console.log(`🚀 Express Primary — Port ${PORT}`);
  console.log(`📝 Logs: ${LOG_DIR}`);
  console.log(`💾 Payloads: ${PAYLOAD_DIR}`);
  console.log(`🔁 Max retries: ${MAX_RETRIES}`);
});
