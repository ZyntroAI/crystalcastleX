{
  "name": "@zyntro-media-ai/crystalcastle",
  "version": "1.5.5",
  "description": "Core components for Crystal Castle",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsup src/index.ts --format cjs,esm --dts",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
