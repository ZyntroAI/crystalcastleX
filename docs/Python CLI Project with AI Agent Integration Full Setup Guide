# 1. Create & enter project folder
mkdir my_cli_project && cd my_cli_project

# 2. Create the files above in the structure shown
# 3. Create virtual environment & install dependencies
uv init --bare
uv add typer rich hatchling

# 4. Install your own project in editable mode (so agents can import it)
pip install -e .

# 5. Activate environment
source .venv/bin/activate   # Linux/macOS
# .venv\Scripts\Activate.ps1  # Windows PowerShell

# 6. Install AI Agent Skills
uvx library-skills

# 7. Test the CLI
python -m my_cli.main --help
# Or:
mycli --help

