"""
Core business logic — Agents import these classes directly
No CLI decorators here — pure Python, reusable anywhere
"""
import os
import json
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional


class DataProcessor:
    """Process and transform data — available to AI Agents"""
    
    @staticmethod
    def summarize_text(text: str, max_length: int = 100) -> Dict[str, Any]:
        """Summarize text data"""
        return {
            "original_length": len(text),
            "summary": text[:max_length] + ("..." if len(text) > max_length else ""),
            "timestamp": datetime.now().isoformat(),
        }

    @staticmethod
    def analyze_data(data: List[Dict]) -> Dict[str, Any]:
        """Basic data analysis"""
        if not data:
            return {"count": 0, "message": "No data provided"}
        return {
            "count": len(data),
            "keys": list(data[0].keys()) if isinstance(data, list) and data else [],
            "sample": data[0] if data else None,
        }


class FileManager:
    """File operations — AI Agents can read/write through here"""
    
    @staticmethod
    def read_json(path: str) -> Optional[Dict]:
        """Read JSON file safely"""
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except FileNotFoundError:
            return None
        except json.JSONDecodeError:
            return {"error": "Invalid JSON format"}

    @staticmethod
    def write_json(path: str, data: Any) -> bool:
        """Write data to JSON file"""
        try:
            Path(path).parent.mkdir(parents=True, exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
            return True
        except Exception as e:
            print(f"Error writing file: {e}")
            return False

    @staticmethod
    def list_files(directory: str, pattern: str = "*") -> List[str]:
        """List files matching pattern"""
        return [str(f) for f in Path(directory).glob(pattern) if f.is_file()]


class SystemService:
    """System utilities — AI Agents can query environment info"""
    
    @staticmethod
    def get_info() -> Dict[str, Any]:
        """Get system and project info"""
        return {
            "project_root": str(Path(__file__).parent.parent.parent),
            "cwd": os.getcwd(),
            "python_version": os.sys.version,
            "timestamp": datetime.now().isoformat(),
        }

